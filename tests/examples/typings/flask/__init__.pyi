"""The parts of Flask 3.1 the README examples use, with their real signatures (Flask is not a
dependency of this repository). Pyright reads it through `stubPath`."""

from collections.abc import Callable, Iterable, Iterator
from typing import Any, Literal, TypeVar, overload

_F = TypeVar("_F", bound=Callable[..., Any])

class Headers:
    """Werkzeug 3.1's `werkzeug.datastructures.Headers`: a multi-dict, not a `Mapping`."""

    @overload
    def __getitem__(self, key: str) -> str: ...
    @overload
    def __getitem__(self, key: int) -> tuple[str, str]: ...
    def __iter__(self) -> Iterator[tuple[str, str]]: ...
    def __len__(self) -> int: ...
    def keys(self, lower: bool = False) -> Iterable[str]: ...
    def values(self) -> Iterable[str]: ...
    def items(self, lower: bool = False) -> Iterable[tuple[str, str]]: ...
    def get(self, key: str, default: str | None = None) -> str | None: ...

class Request:
    headers: Headers
    @overload
    def get_data(
        self, cache: bool = True, as_text: Literal[False] = False, parse_form_data: bool = False
    ) -> bytes: ...
    @overload
    def get_data(
        self, cache: bool = True, *, as_text: Literal[True], parse_form_data: bool = False
    ) -> str: ...

request: Request

class Flask:
    def __init__(self, import_name: str) -> None: ...
    def post(self, rule: str, **options: Any) -> Callable[[_F], _F]: ...
